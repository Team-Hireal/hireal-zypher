ANTHROPIC_API_KEY=sk-ant-your-key-here
# Fallback API key (used if primary is not set)
# ANTHROPIC_API_KEY_FALLBACK=sk-ant-your-fallback-key-here
# Optional: Custom base URL for third-party API providers (e.g., https://api.your-provider.com/v1)
# ANTHROPIC_BASE_URL=https://api.your-provider.com/v1
# Fallback base URL (used if primary is not set)
# ANTHROPIC_BASE_URL_FALLBACK=https://another-provider.com/v1
FIRECRAWL_API_KEY=your-firecrawl-api-key-here
# Fallback Firecrawl API key
# FIRECRAWL_API_KEY_FALLBACK=your-fallback-firecrawl-key
PORT=8000
# Optional during local development. In production point this at the hosted Deno server,
# e.g. https://hireal-zypher-deno.team-hireal.deno.net
DENO_SERVER_URL=http://localhost:8000
